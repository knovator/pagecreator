{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "css": {
      "executor": "nx:run-commands",
      "options": {
        "assets": [
          { "glob": "libs/admin/src/styles/index.css", "input": ".", "output": "." }
        ],
        "commands": [
          "npx @tailwindcss/cli -i src/styles/index.css -o index.css --minify"
        ],
        "cwd": "libs/admin",
        "parallel": true
      }
    },
    "build": {
      "executor": "@nrwl/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/admin",
        "tsConfig": "libs/admin/tsconfig.lib.json",
        "project": "libs/admin/package.json",
        "entryFile": "libs/admin/src/index.ts",
        "rollupConfig": "@nrwl/react/plugins/bundle-rollup",
        "compiler": "babel",
        "assets": [
          {
            "glob": "libs/admin/README.md",
            "input": ".",
            "output": "."
          },
          {
            "glob": "libs/admin/src/styles/index.css",
            "input": ".",
            "output": "."
          }
        ],
        "format": ["cjs", "esm"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/admin/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/libs/admin"],
      "options": {
        "jestConfig": "libs/admin/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
